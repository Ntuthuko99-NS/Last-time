{
  "name": "ServiceAd",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Service title"
    },
    "description": {
      "type": "string",
      "description": "Service description"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "plumber",
        "electrician",
        "gardener",
        "cleaner",
        "painter",
        "handyman",
        "domestic_worker",
        "carpenter",
        "mechanic",
        "tutor",
        "delivery",
        "other"
      ],
      "description": "Type of service"
    },
    "price_range_min": {
      "type": "number",
      "description": "Minimum price in ZAR"
    },
    "price_range_max": {
      "type": "number",
      "description": "Maximum price in ZAR"
    },
    "province": {
      "type": "string",
      "enum": [
        "gauteng",
        "western_cape",
        "kwazulu_natal",
        "eastern_cape",
        "free_state",
        "limpopo",
        "mpumalanga",
        "north_west",
        "northern_cape"
      ]
    },
    "city": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "weekdays",
        "weekends",
        "both",
        "flexible"
      ],
      "default": "flexible"
    },
    "experience_years": {
      "type": "number"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cash",
          "eft",
          "payfast",
          "ozow",
          "snapscan"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "inactive"
      ],
      "default": "active"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "service_type"
  ]
}
